# URL do backend Myde real. SERVER-SIDE apenas (não exposta ao browser).
# Usada pelos route handlers (app/api/**) via services/http/server/backend-client.ts.
#
# Use 127.0.0.1 e NÃO "localhost": no Windows/Node o fetch tenta IPv6 (::1) primeiro,
# e se o backend escuta só em IPv4 (0.0.0.0) o resultado é ECONNREFUSED (503 no BFF).
API_BASE_URL=http://127.0.0.1:8000

# Exemplo com tunnel/backend remoto:
# API_BASE_URL=https://seu-backend.exemplo.com

# O browser fala apenas com /api, então NEXT_PUBLIC_API_BASE_URL NÃO é usada para o
# backend real (o BFF é a única saída). Mantida só por compatibilidade legada.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000